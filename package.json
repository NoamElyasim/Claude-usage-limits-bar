{
  "name": "claude-usage-limits-bar",
  "productName": "Claude Usage Limits Bar",
  "version": "1.3.0",
  "description": "Always-on-top liquid-glass bar showing Claude 5h/7d usage limits and Claude Code session status",
  "main": "main.js",
  "license": "MIT",
  "author": "Noam",
  "scripts": {
    "start": "electron .",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/install-hooks.js --uninstall",
    "make-icon": "node scripts/make-icon.js",
    "glasslab": "electron tools/glasslab/main.js",
    "cursorprobe": "electron tools/cursorprobe",
    "hovertest": "electron tools/hovertest",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "build:native": "bash scripts/build-glass-capture.sh",
    "dist:mac": "npm run build:native && electron-builder --mac",
    "install:mac": "bash scripts/install-mac.sh",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.noam.claude-usage-limits-bar",
    "productName": "Claude Usage Limits Bar",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "hooks/**/*",
      "scripts/install-hooks.js",
      "!**/claude-cookies.txt",
      "!**/claude-session.txt",
      "!**/*.png",
      "!overlay.py",
      "!__pycache__"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Claude Usage Limits Bar"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "LSUIElement": 1
      },
      "extraResources": [
        {
          "from": "bin/glass-capture",
          "to": "glass-capture"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
